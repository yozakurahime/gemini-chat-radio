# Copie para .env e ajuste os valores

SCA_WEB_ENABLED=1
SCA_WEB_LOGIN_URL=https://app.sistemasca.com/login
SCA_WEB_ALUNOS_URL=https://app.sistemasca.com/administrativo/alunos
SCA_WEB_USERNAME=
SCA_WEB_PASSWORD=

# Normalmente funciona com Edge instalado:
SCA_WEB_BROWSER_CHANNEL=msedge
# Se precisar, informe caminho completo:
# SCA_WEB_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

SCA_WEB_HEADLESS=1
SCA_WEB_TIMEOUT_MS=90000
SCA_WEB_CLICK_DELAY_MS=500
SCA_WEB_FILE_PREFIX=sca-alunos
SCA_WEB_KEEP_RAW_FILES=1
SCA_WEB_CONVERT_TO_CSV=1

# Auto-update do proprio programa:
SCA_WEB_AUTO_UPDATE=1
SCA_WEB_UPDATE_CHECK_MINUTES=30
SCA_WEB_UPDATE_META_URL=https://www.academiaoxigenio.com/programarecepcaoweb/meta
SCA_WEB_UPDATE_DOWNLOAD_URL=https://www.academiaoxigenio.com/programarecepcaoweb
SCA_WEB_UPDATE_TIMEOUT_SEC=40

SCA_WEB_SYNC_ENABLED=1
SCA_WEB_SYNC_API_URL=https://www.academiaoxigenio.com/admin/sca/students/sync/batch
SCA_WEB_SYNC_TOKEN=
SCA_WEB_SYNC_SOURCE=sca_web_export
SCA_WEB_SYNC_BATCH_SIZE=300

SCA_WEB_DOWNLOAD_DIR=.\runtime\downloads
SCA_WEB_EXPORT_DIR=.\runtime\exports
SCA_WEB_USER_DATA_DIR=.\runtime\browser-profile
SCA_WEB_LOG_FILE=.\logs\sca-web-export.log

# Configure so se o clique automatico nao funcionar:
# SCA_WEB_LOGIN_USER_SELECTOR=
# SCA_WEB_LOGIN_PASSWORD_SELECTOR=
# SCA_WEB_LOGIN_SUBMIT_SELECTOR=
# SCA_WEB_DOWNLOAD_TRIGGER_SELECTOR=
# SCA_WEB_EXPORT_ACTION_SELECTOR=
# SCA_WEB_EXPORT_ACTION_TEXT=Export
