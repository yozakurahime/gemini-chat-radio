{
  "name": "himefit-modular",
  "version": "5.0.0",
  "description": "HimeFit - Sistema de gestão para academia com atendimento, ponto e WhatsApp",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bootstrap-tools.ps1",
    "panel_v2:install": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 install --no-save",
    "landing:install": "tools\\bin\\npm.cmd --prefix apps\\landing install --no-save",
    "server:install": "tools\\bin\\npm.cmd --prefix apps\\server install --no-save",
    "install:all": "tools\\bin\\npm.cmd run panel_v2:install && tools\\bin\\npm.cmd run landing:install && tools\\bin\\npm.cmd run server:install",
    "panel_v2:dev": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 run dev",
    "panel_v2:build": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 run build",
    "panel_v2:test": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 run test",
    "landing:dev": "tools\\bin\\npm.cmd --prefix apps\\landing run dev",
    "landing:build": "tools\\bin\\npm.cmd --prefix apps\\landing run build",
    "server:start": "tools\\bin\\node.cmd apps\\server\\index.js",
    "server:test": "tools\\bin\\node.cmd --test apps\\server\\tests\\security.test.js apps\\server\\tests\\admin_flows.test.js",
    "server:health-check": "bash tools/deploy/health-check.sh",
    "server:timezone:set": "bash tools/deploy/set-timezone-brasilia.sh",
    "server:health-check:install-cron": "bash tools/deploy/install-health-check-cron.sh",
    "sca:sync:run": "tools\\bin\\node.cmd apps\\server\\scripts\\sca_sync_worker.js",
    "sca:db:sync:run": "tools\\bin\\node.cmd apps\\server\\scripts\\sca_db_sync_worker.js",
    "sca:db:package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\sca-sync\\build_recepcao_package.ps1",
    "deploy:oracle:manual": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\deploy\\deploy_oracle_manual.ps1",
    "check:all": "tools\\bin\\npm.cmd run bootstrap:tools && tools\\bin\\npm.cmd run install:all && tools\\bin\\npm.cmd run panel_v2:test && tools\\bin\\npm.cmd run server:test && tools\\bin\\npm.cmd run panel_v2:build && tools\\bin\\npm.cmd run landing:build",
    "dev": "tools\\bin\\npm.cmd run panel_v2:dev",
    "build": "tools\\bin\\npm.cmd run panel_v2:build",
    "build:dev": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 run build -- --mode development",
    "preview": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 run preview",
    "test": "tools\\bin\\npm.cmd run panel_v2:test && tools\\bin\\npm.cmd run server:test",
    "test:watch": "tools\\bin\\npm.cmd --prefix apps\\panel-v2 run test:watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/query-core": "^5.83.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-leaflet": "^4.2.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^20.0.3",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.himefit.desktop",
    "productName": "Himefit",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "apps/server/index.js",
      "apps/server/ai_service.js",
      "apps/server/app_paths.js",
      "apps/server/panel_auth.js",
      "apps/server/runtime_storage.js",
      "apps/server/attendance_interactive_runtime.js",
      "apps/server/knowledge_context_profile.js",
      "apps/server/owner_whatsapp_reply_runtime.js",
      "apps/server/payments/**/*",
      "apps/server/bootstrap/**/*",
      "apps/server/routes/**/*",
      "apps/server/notify.wav",
      "apps/server/contexto_academia.txt",
      "apps/server/assets/**/*",
      "apps/server/scripts/**/*",
      "apps/panel-v2/dist/**/*",
      "apps/landing/dist/**/*",
      "apps/desktop/**/*",
      "package.json"
    ],
    "extraResources": [
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
