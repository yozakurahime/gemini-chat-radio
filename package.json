{
  "name": "himefit-modular",
  "version": "5.0.0",
  "description": "HimeFit modularizado com backend, painel, landing e desktop separados",
  "private": true,
  "main": "apps/desktop/main.js",
  "workspaces": [
    "apps/server",
    "apps/panel-v2",
    "apps/panel-legacy",
    "apps/landing"
  ],
  "scripts": {
    "start": "npm run server:start",
    "server:start": "npm --prefix apps/server run start",
    "server:test": "npm --prefix apps/server run test",
    "test": "npm run server:test",
    "radio:check": "npm --prefix apps/server run radio:check",
    "landing:dev": "npm --prefix apps/landing run dev",
    "landing:build": "npm --prefix apps/landing run build",
    "landing:preview": "npm --prefix apps/landing run preview",
    "panel:dev": "npm --prefix apps/panel-legacy run dev",
    "panel:build": "npm --prefix apps/panel-legacy run build",
    "panel:preview": "npm --prefix apps/panel-legacy run preview",
    "panel_v2:dev": "npm --prefix apps/panel-v2 run dev",
    "panel_v2:build": "npm --prefix apps/panel-v2 run build",
    "panel_v2:preview": "npm --prefix apps/panel-v2 run preview",
    "build": "npm run panel_v2:build && npm run panel:build && npm run landing:build",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis && (npm --prefix apps/server rebuild better-sqlite3 || echo [WARN] better-sqlite3 rebuild falhou; reinicie terminal/processos e rode npm --prefix apps/server rebuild better-sqlite3 depois)",
    "desktop:publish-manifest": "npm --prefix apps/server run desktop:publish-manifest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^2.1.35",
    "multer": "^2.1.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "music-metadata": "11.12.3",
    "file-type": "22.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.himefit.desktop",
    "productName": "Himefit",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "apps/server/index.js",
      "apps/server/ai_service.js",
      "apps/server/app_paths.js",
      "apps/server/panel_auth.js",
      "apps/server/runtime_storage.js",
      "apps/server/routes/**/*",
      "apps/server/radio.html",
      "apps/server/notify.wav",
      "apps/server/contexto_academia.txt",
      "apps/server/assets/**/*",
      "apps/server/scripts/**/*",
      "apps/panel-v2/dist/**/*",
      "apps/panel-legacy/dist/**/*",
      "apps/landing/dist/**/*",
      "apps/desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/server/yt-dlp.exe",
        "to": "yt-dlp.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
