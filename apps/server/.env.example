GEMINI_API_KEY=""
# Optional provider-managed key (recommended for commercial builds)
# HIMEFIT_PROVIDER_AI_KEY=""
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="coral"
# ADS_AI_ENABLED defaults to on when OPENAI_API_KEY is present
# ADS_AI_ENABLED=1
PAINEL_USER="admin"
PAINEL_PASS="trocar-esta-senha"
PORT=3001
PANEL_V2=1
HIMEFIT_DATA_ROOT=E:\IA_CENTRAL\Novo bot - MODULAR\runtime
APP_PANEL_BASE_URL=https://www.academiaoxigenio.com/painel
ATTENDANCE_ENABLED=1

# yt-dlp auth for YouTube anti-bot
# off | browser | file
YTDLP_COOKIES_MODE=off
# chrome | edge | firefox (used when mode=browser)
YTDLP_COOKIES_BROWSER=chrome
# Optional browser profile name (ex.: Default, Profile 1)
YTDLP_COOKIES_PROFILE=
# Optional cookies file path (used when mode=file)
YTDLP_COOKIES_FILE=

# owner | commercial
HIMEFIT_PROFILE=owner

# Optional data root override (recommended only for commercial profile)
# HIMEFIT_DATA_ROOT=C:\\ProgramData\\Himefit
# APP_PANEL_BASE_URL=https://www.academiaoxigenio.com/painel

# Optional bootstrap values for system config
# HIMEFIT_ACADEMY_NAME="Academia Exemplo"
# HIMEFIT_ADMIN_NAME="Administrador"
# HIMEFIT_UPDATES_MANIFEST_URL="https://seu-dominio.com/updates/manifest.json"
