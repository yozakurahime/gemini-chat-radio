# Copie para .env na maquina da recepcao e ajuste os valores.

SCA_SYNC_ENABLED=1
SCA_SYNC_MODE=db
SCA_SYNC_SOURCE=sca_db
SCA_SYNC_TOKEN=
SCA_SYNC_API_URL=https://www.academiaoxigenio.com/admin/sca/sync/batch

SCA_DB_DIR=C:\SistemaSCA
SCA_DB_FILE=
SCA_DB_ENGINE=auto
SCA_DB_USER=
SCA_DB_PASSWORD=
SCA_DB_ODBC_DRIVER=
SCA_DB_CONNECTION_STRING=

SCA_SYNC_BATCH_SIZE=500
SCA_DB_FETCH_WINDOW=10000
SCA_DB_PROFILE_FILE=C:\HimeFitRecepcao\tools\sca-sync\sca_db_profile.json
SCA_DB_SYNC_CURSOR_FILE=C:\HimeFitRecepcao\runtime\sca_db_sync_cursor.json
SCA_DB_SYNC_LOG_FILE=C:\HimeFitRecepcao\logs\sca-db-sync.log
